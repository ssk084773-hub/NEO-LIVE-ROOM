rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'admin' || 
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Users cannot alter wallet balances, verification status, or roles directly
      allow create: if isOwner(userId) && 
        request.resource.data.coins == 0 && 
        request.resource.data.earningsDiamonds == 0 &&
        request.resource.data.isVerified == false &&
        request.resource.data.role == 'user';
      allow update: if isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coins', 'earningsDiamonds', 'role', 'isVerified', 'isBanned']) ||
        isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Live Rooms Collection
    match /rooms/{roomId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.hostId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.hostId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.hostId == request.auth.uid || isAdmin());

      // Room chat subcollection
      match /messages/{messageId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
        allow delete: if isAuthenticated() && 
          (resource.data.senderId == request.auth.uid || 
           get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid || 
           isAdmin());
      }

      // Room participants subcollection
      match /participants/{participantId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    // Direct Messages
    match /conversations/{convId}/messages/{msgId} {
      allow read, write: if isAuthenticated() && 
        (resource == null || resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
    }

    // Gifts catalog (public read, admin write)
    match /gifts/{giftId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Transactions Ledger (Immutable client read-only)
    match /transactions/{txId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      // Only server-side Cloud Functions / Admin SDK can write transactions
      allow write: if false;
    }

    // Withdrawal Requests
    match /withdrawals/{withdrawalId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Creator Applications
    match /creator_applications/{appId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
    }

    // Reports (users can submit, only admins can view and resolve)
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.userId == 'all');
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
    }
  }
}
